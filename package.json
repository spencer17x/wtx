{
  "name": "@spencer17x/wtx",
  "version": "0.0.0-development",
  "description": "Enhance git worktree creation with initialization and environment setup",
  "license": "MIT",
  "homepage": "https://github.com/spencer17x/wtx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencer17x/wtx.git"
  },
  "bugs": {
    "url": "https://github.com/spencer17x/wtx/issues"
  },
  "bin": {
    "wtx": "npm/bin/wtx.js"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "packageManager": "npm@11.16.0",
  "files": [
    "npm/bin/wtx.js",
    "npm/install.js",
    "npm/platform.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "gofmt -w cmd internal",
    "format:check": "files=\"$(gofmt -l cmd internal)\" && test -z \"$files\" || { printf '%s\\n' \"$files\"; exit 1; }",
    "check:vet": "go vet ./...",
    "check": "npm run format:check && npm run check:vet && npm test && npm run release:check",
    "release:check": "go run github.com/goreleaser/goreleaser/v2@v2.15.3 check",
    "release:snapshot": "go run github.com/goreleaser/goreleaser/v2@v2.15.3 release --snapshot --clean --skip=publish",
    "release:publish": "go run github.com/goreleaser/goreleaser/v2@v2.15.3 release --clean",
    "postinstall": "node npm/install.js",
    "test:npm": "node --test npm/*.test.js scripts/*.test.js",
    "test": "go test ./... && npm run test:npm"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  }
}
